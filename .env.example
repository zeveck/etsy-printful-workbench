# Copy this file to .env and fill in your values. Never commit .env.
# Walkthrough: docs/SETUP-KEYS.md

# --- Etsy (https://www.etsy.com/developers/your-apps) ---
# The "keystring" shown for your app
ETSY_API_KEY=
# The "shared secret" shown next to the keystring (sent as keystring:shared_secret)
ETSY_SHARED_SECRET=
# Optional: skip the shop-name lookup
# ETSY_SHOP_ID=
# Optional: defaults to the Printful store name
# ETSY_SHOP_NAME=
# OAuth scopes requested at /etsy/connect. Default is read-only. Add listings_w only when
# you are ready to publish, then re-run /etsy/connect.
# ETSY_OAUTH_SCOPES=listings_r shops_r
# Must match a Callback URL registered on your Etsy app
# ETSY_REDIRECT_URI=http://localhost:3000/etsy/callback

# --- Printful (https://developers.printful.com/tokens) ---
# Private token, shown once when you create it
PRINTFUL_API_TOKEN=
# Required with an account-level token (which you need to read product templates).
# Find it via GET https://api.printful.com/stores or /api/status.
# PRINTFUL_STORE_ID=

# PORT=3000
